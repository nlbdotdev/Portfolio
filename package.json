{
  "name": "nlb-portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "build": "npm run content:check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "content:check": "node --import tsx scripts/content/check.ts",
    "content:audit": "node --import tsx scripts/content/check.ts --report",
    "test": "node --import tsx --test scripts/content/*.test.ts",
    "audit": "npm audit",
    "assets:optimize": "node --import tsx scripts/assets/optimize.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "item:new": "node --import tsx scripts/content/new-item.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "marked": "^18.0.12",
    "zod": "^4.3.6"
  },
  "overrides": {
    "@sveltejs/kit": {
      "cookie": "0.7.2"
    }
  }
}
